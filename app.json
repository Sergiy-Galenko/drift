{
  "expo": {
    "name": "Drift",
    "slug": "drift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-drift.png",
    "backgroundColor": "#121214",
    "userInterfaceStyle": "dark",
    "scheme": "drift",
    "ios": {
      "bundleIdentifier": "com.drift.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Drift needs access to upload proof of your completed commitments.",
        "NSCameraUsageDescription": "Drift needs camera access to capture proof."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121214"
      },
      "package": "com.drift.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121214",
          "image": "./assets/logo-drift.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Drift needs access to upload proof of your completed commitments.",
          "cameraPermission": "Drift needs camera access to capture proof."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-drift.png",
          "color": "#121214",
          "defaultChannel": "default"
        }
      ],
      "expo-video",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
